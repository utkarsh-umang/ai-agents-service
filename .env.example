# Copy to .env and replace placeholders. Required for importing the package.
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# ScrapingBee — OPTIONAL fallback for the youtube_about_enricher node (free HTTP GET is tried first; ScrapingBee only used if YouTube blocks the request).
SCRAPINGBEE_API_KEY=your-scrapingbee-key-here

# Langfuse — use Cloud in prod, or local Docker for development (see below).
LANGFUSE_EMAIL_FINDER_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_EMAIL_FINDER_SECRET_KEY=sk-lf-your-secret-key
# Local: http://localhost:3001 after `docker compose -f docker-compose.langfuse.yml up -d`
# Cloud (default if unset in code): https://us.cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3001
